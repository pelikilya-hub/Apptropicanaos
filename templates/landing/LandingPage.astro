---
// Скелет страницы. Порядок секций фиксирован.
// Пустые по конфигу необязательные секции схлопываются.
import { fact, has } from '@config/load.mjs';
import Layout from './Layout.astro';
import Header from '@ui/Header.astro';
import Footer from '@ui/Footer.astro';
import Section from '@ui/Section.astro';
import Button from '@ui/Button.astro';
import StickyCta from '@ui/StickyCta.astro';
import Fonar from '@fonar/Fonar.astro';
import Insight from '@insight/Insight.astro';
import Hero from '@media/Hero.astro';
import Gallery from '@media/Gallery.astro';
import Plans from '@media/Plans.astro';
import Video from '@media/Video.astro';
import Quiz from '@quiz/Quiz.astro';
import Explain from '@explain/Explain.astro';

interface Props { landing: any; preset: any }
const { landing, preset } = Astro.props;

const {
  slug,
  type,
  seo = {},
  hero = {},
  fonar = null,
  insight = {},
  audienceFit = {},
  explanations = [],
  faq = [],
  units = [],
  media = {},
  neighbors = [],
  anchors = [],
  geo = {},
  brand = {},
  legal = {},
  cta = {},
  budget = {},
  afterKeys = {},
  comparison = null,
  analytics = {},
} = landing;

const provider = analytics?.provider || 'none';
const primaryCtaLabel = hero?.primaryCta?.trim() || 'Разобрать мой сценарий';
const geoAnchors = anchors.length ? anchors : geo?.anchors || [];

const finalTitle = cta?.finalTitle?.trim() || 'Пройдите разбор — маршрут увидите сразу';
const finalBody =
  cta?.finalBody?.trim() ||
  'Никаких звонков «просто уточнить». Сначала вы видите, подходит ли вам этот фокус, ' +
    'и только потом решаете, продолжать ли разговор.';
---
<Layout landing={landing}>
  <Header brand={brand} hasOffer={Boolean(fonar && has(fonar.headline))} />

  <!-- 2. Hero -->
  <Hero slug={slug} image={media.hero} eyebrow={has(hero?.eyebrow) ? hero.eyebrow : undefined}>
    <h1 class="text-h1 max-w-[18ch]">
      {fact(seo?.h1)}
    </h1>

    <p class="mt-7 text-lead text-muted max-w-measure">
      {fact(hero?.lead)}
    </p>

    <div class="mt-10 flex flex-wrap items-center gap-6" data-hero-cta>
      <Button href="#quiz" event="cta_click" eventLabel="hero_primary">
        {primaryCtaLabel}
      </Button>
      {has(hero?.secondaryCta) && (
        <Button href="#insight" variant="ghost" event="cta_click" eventLabel="hero_secondary">
          {hero.secondaryCta}
        </Button>
      )}
    </div>
  </Hero>

  <!-- 3. Фонарь: офферный блок. Схлопывается, если оффера у домена нет. -->
  {fonar && has(fonar.headline) && <Fonar fonar={fonar} />}

  <!-- 4. Стоит понять до просмотра: честный разбор, обязателен -->
  <Insight insight={insight} />

  <Gallery
    slug={slug}
    items={media.gallery ?? []}
    eyebrow="Как это выглядит"
    title={media.galleryTitle ?? 'Проект в кадрах'}
    note={media.galleryNote}
  />

  <!-- 5. Кому страница / антикому -->
  {(has(audienceFit?.forWhom) || has(audienceFit?.notForWhom)) && (
    <Section id="fit"  eyebrow="Кому эта страница">
      <div class="grid gap-10 md:grid-cols-2 max-w-4xl">
        <div>
          <h3 class="eyebrow mb-6" style="color: var(--c-teal);">Вам сюда</h3>
          <ul class="grid gap-3">
            {(audienceFit.forWhom || []).map((x: string) => (
              <li class="text-body border-l border-line pl-5">{x}</li>
            ))}
          </ul>
        </div>
        <div>
          <h3 class="eyebrow mb-6">Вам не сюда</h3>
          <ul class="grid gap-3">
            {(audienceFit.notForWhom || []).map((x: string) => (
              <li class="text-body border-l border-line pl-5 text-muted">{x}</li>
            ))}
          </ul>
        </div>
      </div>
    </Section>
  )}

  <!-- Якоря района: только для type=area -->
  {type === 'area' && geoAnchors.length > 0 && (
    <Section id="anchors"  eyebrow="Якоря места" title="Что рядом и что это меняет">
      <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {geoAnchors.map((a: any) => (
          <li class="bg-paper-dim border border-line rounded p-6">
            <p class="font-display text-[1.2rem] mb-2">{typeof a === 'string' ? a : a.name}</p>
            {typeof a !== 'string' && a.note && (
              <p class="text-small text-muted">{a.note}</p>
            )}
          </li>
        ))}
      </ul>
    </Section>
  )}

  <!-- Мини-шахматка: только для type=project и только при реальных данных -->
  {type === 'project' && units.length > 0 && (
    <Section id="units"  eyebrow="Инвентарь" title="Что есть в продаже">
      <div class="overflow-x-auto">
        <table class="w-full min-w-[40rem] border-collapse text-small">
          <thead>
            <tr class="text-left text-muted border-b border-line">
              <th class="py-3 pr-4 font-medium">Тип</th>
              <th class="py-3 pr-4 font-medium">Спальни</th>
              <th class="py-3 pr-4 font-medium">м²</th>
              <th class="py-3 pr-4 font-medium">Вид</th>
              <th class="py-3 pr-4 font-medium">Право</th>
              <th class="py-3 pr-4 font-medium">Статус</th>
              <th class="py-3 font-medium">Цена</th>
            </tr>
          </thead>
          <tbody>
            {units.map((u: any) => (
              <tr class="border-b border-line align-top">
                <td class="py-3 pr-4">{fact(u.type)}</td>
                <td class="py-3 pr-4">{fact(u.bedrooms)}</td>
                <td class="py-3 pr-4">{fact(u.area)}</td>
                <td class="py-3 pr-4">{fact(u.view)}</td>
                <td class="py-3 pr-4">{fact(u.ownership)}</td>
                <td class="py-3 pr-4">{fact(u.status)}</td>
                <td class="py-3">{u.price?.trim() || 'по запросу'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </Section>
  )}

  <!-- Сравнительная таблица: только для type=compare -->
  {type === 'compare' && comparison?.rows?.length > 0 && (
    <Section id="compare"  eyebrow="Сравнение" title={comparison.title || 'Два сценария рядом'}>
      <div class="overflow-x-auto">
        <table class="w-full min-w-[36rem] border-collapse text-small">
          <thead>
            <tr class="text-left text-muted border-b border-line">
              <th class="py-3 pr-4 font-medium">Критерий</th>
              <th class="py-3 pr-4 font-medium">{fact(comparison.left)}</th>
              <th class="py-3 font-medium">{fact(comparison.right)}</th>
            </tr>
          </thead>
          <tbody>
            {comparison.rows.map((r: any) => (
              <tr class="border-b border-line align-top">
                <td class="py-3 pr-4 text-muted">{r.label}</td>
                <td class="py-3 pr-4">{fact(r.left)}</td>
                <td class="py-3">{fact(r.right)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </Section>
  )}

  <!-- Рамка бюджета: только если данные есть -->
  {has(budget?.items) && (
    <Section id="budget"  eyebrow="Рамка бюджета" title={budget.title || 'Из чего складывается сумма'}>
      <ul class="grid gap-4 max-w-2xl">
        {budget.items.map((b: any) => (
          <li class="flex justify-between gap-6 border-b border-line py-3 text-body">
            <span>{b.label}</span>
            <span class="text-muted text-right">{fact(b.value)}</span>
          </li>
        ))}
      </ul>
      {has(budget?.note) && (
        <p class="mt-8 text-small text-muted max-w-measure">{budget.note}</p>
      )}
    </Section>
  )}

  <Plans
    slug={slug}
    groups={media.plans ?? []}
    eyebrow="Планировки"
    title={media.plansTitle ?? 'Что внутри каждого типа'}
  />

  <!-- 6 + 7. Квиз и маршрут -->
  <Quiz slug={slug} preset={preset} analyticsProvider={provider} cta={cta} />

  <Video
    slug={slug}
    items={media.video ?? []}
    eyebrow="Видео"
    title={media.videoTitle ?? 'Обход по вилле'}
  />

  <!-- Жизнь после ключей: только если в конфиге есть сервисный оффер -->
  {has(afterKeys?.items) && (
    <Section id="after-keys"  eyebrow="После ключей" title={afterKeys.title || 'Что дальше и кто это делает'}>
      <div class="grid gap-6 md:grid-cols-2 max-w-4xl">
        <ul class="grid gap-3">
          {(afterKeys.items || []).map((x: string) => (
            <li class="text-body border-l-2 border-teal pl-5">{x}</li>
          ))}
        </ul>
        {has(afterKeys?.notItems) && (
          <ul class="grid gap-3">
            {afterKeys.notItems.map((x: string) => (
              <li class="text-body border-l border-line pl-5 text-muted">{x}</li>
            ))}
          </ul>
        )}
      </div>
    </Section>
  )}

  <!-- 8. Здравые разъяснения -->
  <Section id="explain"  eyebrow="Здравые разъяснения" title="То, что стоит понять до депозита">
    <div class="max-w-3xl">
      <Explain items={explanations} />
    </div>
  </Section>

  <!-- 9. FAQ -->
  {faq.length > 0 && (
    <Section id="faq"  eyebrow="FAQ" title="Частые вопросы по этому фокусу">
      <div class="max-w-3xl divide-y divide-line border-y border-line">
        {faq.map((item: any, i: number) => (
          <details name="faq" open={i === 0} class="group py-5">
            <summary class="cursor-pointer list-none flex items-start justify-between gap-6 text-lead">
              <span class="max-w-measure">{item.q}</span>
              <span aria-hidden="true" class="mt-1 shrink-0 text-muted transition-transform group-open:rotate-45">+</span>
            </summary>
            <p class="mt-5 text-body text-muted max-w-measure">{item.a}</p>
          </details>
        ))}
      </div>
    </Section>
  )}

  <!-- 10. Финальный CTA -->
  <Section id="final" tone="dark" ruled={false} eyebrow="Дальше">
    <div class="max-w-2xl">
      <h2 class="text-h2 max-w-[20ch] mb-6">
        {finalTitle}
      </h2>
      <p class="text-body text-paper-dim max-w-measure mb-10">
        {finalBody}
      </p>
      <a href="#quiz" data-event="cta_click" data-event-label="final" class="btn btn--primary">
        {primaryCtaLabel}
      </a>
    </div>
  </Section>

  <!-- 11. Footer + дисклеймер -->
  <Footer brand={brand} legal={legal} neighbors={neighbors} />

  <StickyCta label={primaryCtaLabel} href="#quiz" />
</Layout>
