---
import '@ui/base.css';
import Seo from '@seo/Seo.astro';

interface Props { landing: any }
const { landing } = Astro.props;
---
<!doctype html>
<html lang={landing.language || 'ru'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <Seo landing={landing} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500&family=Lora:wght@400;500&display=swap"
    />
  </head>
  <body>
    <slot />
  </body>
</html>
