---
// Фонарь — офферный блок: цена, условия, срок, остаток.
// Приманка, ради которой человек остановился.
//
// Жёсткое правило каркаса: срочность и дефицит существуют ТОЛЬКО как
// структурированные поля с источником (source) и датой (validUntil).
// Валидатор роняет сборку, если источника нет или дата уже прошла;
// в свободном тексте страницы «осталось N» и «успей купить» по-прежнему запрещены.
import { fact, has } from '@config/load.mjs';

interface Offer {
  label?: string;
  headline?: string;
  body?: string;
  price?: { value?: string; note?: string; source?: string; validUntil?: string };
  terms?: Array<{ label: string; value?: string }>;
  scarcity?: { text?: string; remaining?: number; source?: string; validUntil?: string };
  deadline?: { text?: string; validUntil?: string; source?: string; showCountdown?: boolean };
  ctaLabel?: string;
  ctaHref?: string;
}
interface Props { fonar: Offer }
const { fonar } = Astro.props;

const label = fonar?.label?.trim() || 'Предложение';
const ctaHref = fonar?.ctaHref || '#quiz';
const ctaLabel = fonar?.ctaLabel?.trim() || 'Забрать условия';

const terms = fonar?.terms ?? [];
const scarcity = fonar?.scarcity;
const deadline = fonar?.deadline;

// Дата, после которой блок сам себя убирает: между деплоями оффер протухнуть не должен.
const expiresAt = deadline?.validUntil || scarcity?.validUntil || '';

// «По запросу» — не цифра, и набирать её крупным дисплейным кеглем нечестно:
// плашка обещает число, которого нет. Без цифр в значении кегль опускается.
const priceValue = fonar?.price?.value ?? '';
const priceIsFigure = /\d/.test(priceValue);

const humanDate = (iso?: string) => {
  if (!iso) return '';
  const d = new Date(`${iso}T23:59:59`);
  return Number.isNaN(d.getTime())
    ? iso
    : d.toLocaleDateString('ru-RU', { day: 'numeric', month: 'long', year: 'numeric' });
};
---
<section id="fonar" class="band band--ruled" data-offer data-expires={expiresAt || undefined}>
  <div class="container-page">
    <p class="eyebrow mb-4" style="color: var(--c-gold);">{label}</p>

    <div class="grid gap-12 lg:grid-cols-[1.25fr_1fr] lg:gap-16 lg:items-start">
      <div>
        <h2 class="text-h2 max-w-[20ch]">{fact(fonar?.headline)}</h2>

        {has(fonar?.body) && (
          <p class="mt-6 text-body text-muted max-w-measure">{fonar.body}</p>
        )}

        {terms.length > 0 && (
          <dl class="mt-10 max-w-xl">
            {terms.map((t) => (
              <div class="flex justify-between gap-6 border-b border-line py-3">
                <dt class="text-small text-muted">{t.label}</dt>
                <dd class="text-small text-right tabular-nums">{fact(t.value)}</dd>
              </div>
            ))}
          </dl>
        )}
      </div>

      <!-- Ценовая карточка: единственный залитый элемент блока -->
      <aside class="bg-paper-dim border border-line rounded p-7 md:p-8">
        <p
          class={
            priceIsFigure
              ? 'font-display text-[2.1rem] md:text-[2.4rem] leading-none'
              : 'font-display text-[1.3rem] md:text-[1.45rem] leading-snug text-muted'
          }
        >
          {fact(fonar?.price?.value)}
        </p>

        {has(fonar?.price?.note) && (
          <p class="mt-3 text-small text-muted">{fonar.price?.note}</p>
        )}

        {(has(deadline?.text) || has(deadline?.validUntil)) && (
          <p class="mt-7 pt-5 border-t border-line text-small">
            {deadline?.text?.trim() || 'Условия действуют'} до {humanDate(deadline?.validUntil)}
            {deadline?.showCountdown && (
              <span class="block mt-1 text-small text-muted tabular-nums" data-countdown></span>
            )}
          </p>
        )}

        {has(scarcity?.text) && (
          <p class="mt-3 text-small">
            {scarcity?.text}
            {typeof scarcity?.remaining === 'number' && (
              <span class="ml-1 tabular-nums" style="color: var(--c-gold);">— {scarcity.remaining}</span>
            )}
          </p>
        )}

        <a
          href={ctaHref}
          data-event="cta_click"
          data-event-label="fonar_offer"
          class="mt-8 flex items-center justify-center min-h-[48px] w-full rounded bg-graphite text-paper text-small no-underline hover:bg-graphite-2 transition-colors"
        >
          {ctaLabel}
        </a>

        {(has(fonar?.price?.source) || has(scarcity?.source) || has(deadline?.source)) && (
          <p class="mt-5 text-[0.7rem] leading-relaxed text-muted">
            Источник: {[fonar?.price?.source, deadline?.source, scarcity?.source]
              .filter(Boolean)
              .join(' · ')}
          </p>
        )}
      </aside>
    </div>
  </div>
</section>

<script>
  // Оффер с прошедшей датой убирает себя сам. Это подстраховка на случай,
  // когда домен задеплоен, а срок вышел между релизами: валидатор ловит это
  // на сборке, но живой домен не должен показывать протухшую акцию.
  const block = document.querySelector<HTMLElement>('[data-offer]');
  const expires = block?.dataset.expires;

  if (block && expires) {
    const end = new Date(`${expires}T23:59:59`).getTime();

    if (!Number.isNaN(end)) {
      if (Date.now() > end) {
        block.hidden = true;
      } else {
        const el = block.querySelector<HTMLElement>('[data-countdown]');
        if (el) {
          const tick = () => {
            const left = end - Date.now();
            if (left <= 0) {
              block.hidden = true;
              return;
            }
            const days = Math.floor(left / 86_400_000);
            const hours = Math.floor((left % 86_400_000) / 3_600_000);
            el.textContent =
              days > 0 ? `осталось ${days} дн. ${hours} ч.` : `осталось ${hours} ч.`;
          };
          tick();
          setInterval(tick, 60_000);
        }
      }
    }
  }
</script>
