---
// Здравые разъяснения. Пакет даёт структуру, текст приходит из ветки.
// Формат: вопрос клиента -> 3-6 предложений -> «что сделать до резерва»
// -> при необходимости «это к юристу».
import { has } from '@config/load.mjs';

interface Item {
  question: string;
  body: string | string[];
  beforeReserve?: string;
  lawyer?: boolean;
}
interface Props { items: Item[] }
const { items = [] } = Astro.props;

const paragraphs = (body: string | string[]) =>
  Array.isArray(body) ? body : String(body).split(/\n{2,}/);
---
<div class="divide-y divide-line border-y border-line">
  {items.map((item, i) => (
    <details name="explain" open={i === 0} class="group py-5">
      <summary
        class="cursor-pointer list-none flex items-start justify-between gap-6 font-ui text-[1.05rem] leading-snug"
      >
        <span class="max-w-measure">{item.question}</span>
        <span
          aria-hidden="true"
          class="mt-1 shrink-0 text-muted transition-transform duration-200 group-open:rotate-45"
        >+</span>
      </summary>

      <div class="prose-page mt-5 font-ui text-[0.98rem] text-muted">
        {paragraphs(item.body).map((p) => <p>{p}</p>)}

        {has(item.beforeReserve) && (
          <p class="mt-5 border-l-2 border-teal pl-4 text-graphite">
            <strong class="font-medium">Что сделать до резерва:</strong> {item.beforeReserve}
          </p>
        )}

        {item.lawyer && (
          <p class="mt-3 font-ui text-xs uppercase tracking-[0.14em] text-gold">
            Это вопрос к независимому юристу, не к продавцу
          </p>
        )}
      </div>
    </details>
  ))}
</div>
