---
// «Стоит понять до просмотра» — блок честного разбора.
// Это НЕ оффер: ни цены, ни срока, ни остатка здесь нет.
// Задача: высветить неудобную правду связки «место × аудитория × формат»
// и отличить домен от портала. Именно этот блок кормит органику.
import { fact, has } from '@config/load.mjs';

interface Props {
  insight: {
    label?: string;
    strike?: string;
    body?: string;
    splitYes?: string;
    splitNo?: string;
    ctaLabel?: string;
    ctaHref?: string;
  };
}
const { insight } = Astro.props;
const label = insight?.label?.trim() || 'Стоит понять до просмотра';
const ctaHref = insight?.ctaHref || '#quiz';
const ctaLabel = insight?.ctaLabel?.trim() || 'Разобрать мой сценарий';
---
<section id="insight" class="bg-ink text-paper">
  <div class="container-page py-20 md:py-28">
    <p class="eyebrow mb-8 text-sand">{label}</p>

    <p class="font-display text-strike max-w-[24ch] md:max-w-[28ch]">{fact(insight?.strike)}</p>

    <div class="h-px w-20 my-10" style="background: var(--c-gold);"></div>

    <p class="text-body text-paper-dim max-w-measure">{fact(insight?.body)}</p>

    {(has(insight?.splitYes) || has(insight?.splitNo)) && (
      <dl class="mt-14 grid gap-10 sm:grid-cols-2 max-w-3xl">
        <div>
          <dt class="eyebrow mb-3 text-sand">Вам сюда, если</dt>
          <dd class="text-small text-paper-dim">{fact(insight?.splitYes)}</dd>
        </div>
        <div>
          <dt class="eyebrow mb-3 text-muted">Не сюда, если</dt>
          <dd class="text-small text-paper-dim">{fact(insight?.splitNo)}</dd>
        </div>
      </dl>
    )}

    <a
      href={ctaHref}
      data-event="cta_click"
      data-event-label="insight"
      class="mt-12 inline-flex items-center justify-center min-h-[48px] px-7 rounded border border-graphite-3 text-paper text-small no-underline hover:border-sand transition-colors"
    >
      {ctaLabel}
    </a>
  </div>
</section>
