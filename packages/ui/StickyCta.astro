---
// На мобиле липкий CTA ровно один. Вторичное действие с ним не спорит.
// Он появляется, только когда его есть смысл показывать: пока кнопка первого
// экрана видна, дублировать её нечем, а на самом квизе и на маршруте
// предлагать «перейти к разбору» уже поздно.
interface Props { label: string; href: string }
const { label, href } = Astro.props;
---
<div
  data-sticky-bar
  class="md:hidden fixed bottom-0 inset-x-0 z-40 bg-paper/95 backdrop-blur border-t border-line px-5 py-3.5
         translate-y-full opacity-0 pointer-events-none
         transition-[transform,opacity] duration-300 ease-out motion-reduce:transition-none
         data-[shown]:translate-y-0 data-[shown]:opacity-100 data-[shown]:pointer-events-auto"
>
  <a
    href={href}
    data-event="cta_click"
    data-event-label="sticky"
    class="btn btn--primary w-full"
  >
    {label}
  </a>
</div>

<script>
  const bar = document.querySelector<HTMLElement>('[data-sticky-bar]');
  if (bar) {
    document.body.setAttribute('data-sticky-cta', 'true');

    // Что заставляет панель молчать: кнопка первого экрана, сам квиз и маршрут.
    const mutes = ['[data-hero-cta]', '#quiz', '[data-route-section]']
      .map((s) => document.querySelector(s))
      .filter(Boolean) as Element[];

    if ('IntersectionObserver' in window && mutes.length) {
      const seen = new Set<Element>();
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) seen.add(e.target);
            else seen.delete(e.target);
          }
          // Маршрут показан — разбор уже пройден, звать к нему больше незачем.
          const routeOpen = mutes.some(
            (m) => m.hasAttribute('data-route-section') && !(m as HTMLElement).hidden
          );
          if (seen.size === 0 && !routeOpen) bar.setAttribute('data-shown', '');
          else bar.removeAttribute('data-shown');
        },
        { threshold: 0 }
      );
      mutes.forEach((m) => io.observe(m));
    } else {
      bar.setAttribute('data-shown', '');
    }
  }
</script>
