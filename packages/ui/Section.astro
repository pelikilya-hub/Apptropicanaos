---
interface Props {
  id?: string;
  /** paper — холст страницы, dark — единственная тёмная плашка, ruled — с линией сверху */
  tone?: 'paper' | 'dark';
  ruled?: boolean;
  eyebrow?: string;
  title?: string;
  lead?: string;
  class?: string;
}
const { id, tone = 'paper', ruled = true, eyebrow, title, lead, class: cls = '' } = Astro.props;

const tones = { paper: '', dark: 'bg-ink text-paper' } as const;
// Линия рисуется только на холсте: на тёмной плашке её роль играет сам фон.
const rule = ruled && tone === 'paper' ? 'band--ruled' : '';
---
<section id={id} class={`band ${rule} ${tones[tone]} ${cls}`}>
  <div class="container-page">
    {eyebrow && <p class={`eyebrow mb-4 ${tone === 'dark' ? 'text-sand' : ''}`}>{eyebrow}</p>}
    {title && <h2 class="text-h2 max-w-[22ch]">{title}</h2>}
    {lead && (
      <p class={`mt-5 text-body max-w-measure ${tone === 'dark' ? 'text-paper-dim' : 'text-muted'}`}>
        {lead}
      </p>
    )}
    <div class={title || lead ? 'mt-12' : ''}><slot /></div>
  </div>
</section>
