---
import Disclaimer from '@legal/Disclaimer.astro';
interface Props {
  brand: { name?: string };
  legal: { disclaimer?: string; notOffer?: boolean };
  neighbors?: Array<{ label: string; href: string; rel?: string }>;
}
const { brand, legal, neighbors = [] } = Astro.props;
const year = new Date().getFullYear();
---
<footer class="bg-ink text-paper pb-16">
  <div class="container-page">
    {neighbors.length > 0 && (
      <nav aria-label="Соседние домены" class="mb-12">
        <p class="eyebrow text-sand-dim mb-5">
          Смежные вопросы
        </p>
        <ul class="grid gap-3 sm:grid-cols-2">
          {neighbors.map((n) => (
            <li>
              <a
                href={n.href}
                rel={n.rel || 'noopener'}
                class="text-small text-paper-dim underline underline-offset-4 decoration-graphite-3 hover:decoration-sand"
              >
                {n.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )}

    <Disclaimer legal={legal} />

    <p class="mt-10 text-small text-sand-dim">
      © {year} {brand?.name?.trim() || '[ДАННЫЕ]'}
    </p>
  </div>
</footer>
