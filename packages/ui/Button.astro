---
// Три роли на всю фабрику: действие, альтернатива, тихая ссылка.
// Цвет действия один — если на странице появился второй, это ошибка вёрстки.
interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'ghost';
  event?: string;
  eventLabel?: string;
  class?: string;
}
const { href, variant = 'primary', event, eventLabel, class: cls = '' } = Astro.props;

const styles = {
  primary: 'btn--primary',
  secondary: 'btn--outline',
  ghost: 'btn--quiet',
} as const;
---
<a
  href={href}
  class={`btn ${styles[variant]} ${cls}`}
  data-event={event}
  data-event-label={eventLabel}
>
  <slot />
</a>
