{
  "name": "base",
  "steps": [
    {
      "id": "task",
      "question": "Что вы решаете этой покупкой?",
      "note": "Ответ меняет всё дальше: формат, бюджетный коридор и горизонт.",
      "options": [
        { "id": "live", "label": "Жить самому" },
        { "id": "rent", "label": "Сдавать" },
        { "id": "both", "label": "И жить, и сдавать" },
        { "id": "explore", "label": "Пока разбираюсь" }
      ]
    },
    {
      "id": "format",
      "question": "Какой формат рассматриваете?",
      "options": [
        { "id": "apartment", "label": "Апартаменты в кондо" },
        { "id": "villa-complex", "label": "Вилла в комплексе" },
        { "id": "villa-standalone", "label": "Отдельностоящая вилла" },
        { "id": "branded", "label": "Branded residence" },
        { "id": "land", "label": "Земля" },
        { "id": "unsure", "label": "Ещё не знаю" }
      ]
    },
    {
      "id": "geo",
      "question": "География важна?",
      "options": [
        { "id": "this", "label": "Да, интересует именно этот фокус" },
        { "id": "compare", "label": "Хочу сравнить с соседним районом" },
        { "id": "any", "label": "Место не принципиально" }
      ]
    },
    {
      "id": "budget",
      "question": "В каком коридоре считаете бюджет?",
      "note": "Коридор нужен, чтобы не показывать вам то, что вам не подходит.",
      "options": [
        { "id": "u150", "label": "До 150 000 $" },
        { "id": "150-300", "label": "150 000 – 300 000 $" },
        { "id": "300-600", "label": "300 000 – 600 000 $" },
        { "id": "600plus", "label": "От 600 000 $" },
        { "id": "unset", "label": "Не готов называть" }
      ]
    },
    {
      "id": "horizon",
      "question": "Когда планируете сделку?",
      "options": [
        { "id": "looking", "label": "Просто смотрю рынок" },
        { "id": "season", "label": "В этот сезон" },
        { "id": "offplan", "label": "Готов ждать сдачи off-plan" }
      ]
    },
    {
      "id": "method",
      "question": "Как планируете вести сделку?",
      "options": [
        { "id": "onsite", "label": "Приеду на остров" },
        { "id": "remote", "label": "Удалённо, без перелёта" },
        { "id": "concierge", "label": "Через доверенного представителя" }
      ]
    }
  ],
  "routing": [
    { "route": "learn", "when": { "task": ["explore"], "horizon": ["looking"] } },
    { "route": "neighbor", "when": { "geo": ["compare"] } },
    { "route": "remote", "when": { "method": ["remote"] } },
    { "route": "budget", "when": { "budget": ["u150"], "format": ["villa-complex", "villa-standalone", "branded"] } },
    { "route": "learn", "when": { "task": ["explore"] } },
    { "route": "learn", "when": { "format": ["unsure"], "horizon": ["looking"] } }
  ],
  "fallbackRoute": "fit",
  "routes": {
    "fit": {
      "title": "Ваш сценарий совпал с фокусом этой страницы",
      "body": "[ДАННЫЕ] — опишите, что именно вы соберёте под такой ответ: какие объекты, в каком коридоре, с какими оговорками.",
      "ctaLabel": "Забрать эту подборку в Telegram"
    },
    "neighbor": {
      "title": "Скорее всего, вам нужен соседний разбор",
      "body": "[ДАННЫЕ] — объясните, чем соседний район или формат отличается и почему он ближе к такому ответу.",
      "outboundLabel": "[ДАННЫЕ]",
      "outboundHref": "",
      "ctaLabel": "Всё равно обсудить этот фокус"
    },
    "budget": {
      "title": "В этом коридоре здесь честнее сузить выбор",
      "body": "[ДАННЫЕ] — назовите, что реально попадает в коридор, а что нет, без обещаний «найдём что-нибудь».",
      "ctaLabel": "Показать, что попадает в коридор"
    },
    "learn": {
      "title": "Вы ещё изучаете рынок — это нормальный этап",
      "body": "[ДАННЫЕ] — что дать человеку на этом этапе: разбор механики, чек-лист проверки, сравнение форматов. Без давления на сделку.",
      "ctaLabel": "Получить разбор без звонков"
    },
    "remote": {
      "title": "Сделка без перелёта: разберём порядок шагов",
      "body": "[ДАННЫЕ] — опишите, как устроена удалённая сделка: доверенность, проверка документов, перевод средств, приёмка. Без обхода закона.",
      "ctaLabel": "Разобрать удалённый сценарий"
    }
  }
}
