---
// Квиз + маршрут. Один вопрос на экран, назад без потери, финиш анонимный.
// Контакт появляется только внутри маршрута, не раньше.
import type { QuizPreset } from './types';

interface Props {
  slug: string;
  preset: QuizPreset;
  analyticsProvider?: string;
  cta: { primaryChannel?: string; primaryValue?: string; afterQuiz?: boolean };
}
const { slug, preset, analyticsProvider = 'none', cta } = Astro.props;

const total = preset.steps.length;
const routeIds = Object.keys(preset.routes);

// Канал контакта берётся из конфига. Телефон не обязателен, если есть мессенджер.
const contactHref = (() => {
  const v = (cta?.primaryValue || '').trim();
  if (!v) return '';
  if (/^https?:\/\//.test(v)) return v;
  if (cta?.primaryChannel === 'telegram') return `https://t.me/${v.replace(/^@/, '')}`;
  if (cta?.primaryChannel === 'whatsapp') return `https://wa.me/${v.replace(/[^\d]/g, '')}`;
  if (cta?.primaryChannel === 'email') return `mailto:${v}`;
  return v;
})();
---
<section id="quiz" class="band band--ruled">
  <div class="container-page layout-rail">
    <div class="rail">
      <p class="eyebrow rail__label">Разбор сценария</p>
    </div>

    <div data-reveal>
    <h2 class="text-h2 max-w-[20ch] mb-4">
      {total} вопросов — и вы увидите свой маршрут
    </h2>
    <p class="text-small text-muted max-w-measure mb-12">
      Ответы сохраняются в браузере. Назад можно вернуться без потери.
      Контакт не обязателен: маршрут вы увидите в любом случае.
    </p>

    <div
      id="quiz-app"
      data-slug={slug}
      data-provider={analyticsProvider}
      data-total={total}
      class="max-w-2xl"
    >
      <!-- прогресс -->
      <div class="mb-8" data-quiz-progress>
        <div class="h-px w-full bg-line">
          <div class="h-px bg-teal transition-all duration-300" data-quiz-bar style="width:0%"></div>
        </div>
        <p class="mt-3 font-ui text-xs text-muted">
          Шаг <span data-quiz-current>1</span> из {total}
        </p>
      </div>

      <!-- шаги -->
      {preset.steps.map((step, i) => (
        <fieldset data-quiz-step={String(i)} hidden={i !== 0} class="border-0 p-0 m-0">
          <legend class="font-display text-[1.35rem] md:text-[1.7rem] mb-2 p-0">
            {step.question}
          </legend>
          {step.note && <p class="font-ui text-sm text-muted mb-6 max-w-measure">{step.note}</p>}

          <div class="grid gap-2.5 mt-6">
            {step.options.map((opt) => (
              <label class="opt">
                <input
                  type="radio"
                  name={step.id}
                  value={opt.id}
                  class="sr-only"
                  data-quiz-input
                />
                <span class="opt__mark" aria-hidden="true"><span class="opt__dot"></span></span>
                <span class="font-ui text-[0.98rem]">
                  {opt.label}
                  {opt.hint && <span class="block text-sm text-muted">{opt.hint}</span>}
                </span>
              </label>
            ))}
          </div>
        </fieldset>
      ))}

      <div class="flex items-center gap-4 mt-8" data-quiz-nav>
        <button type="button" data-quiz-back hidden class="btn btn--outline">
          Назад
        </button>
        <button type="button" data-quiz-restart hidden class="btn btn--quiet text-muted">
          Начать заново
        </button>
      </div>
    </div>
    </div>
  </div>
</section>

<!-- Маршрут после квиза -->
<section id="route" class="band band--ruled" data-route-section hidden>
  <div class="container-page layout-rail">
    <div class="rail">
      <p class="eyebrow rail__label">Ваш маршрут</p>
    </div>

    <div class="max-w-2xl">
    {routeIds.map((id) => {
      const r = (preset.routes as any)[id];
      return (
        <article data-route={id} hidden>
          <h2 class="text-h2 mb-6 max-w-[22ch]">{r.title}</h2>
          <p class="font-ui text-[1.02rem] leading-relaxed text-muted max-w-measure">{r.body}</p>

          {r.outboundHref && (
            <p class="mt-6">
              <a
                href={r.outboundHref}
                rel="noopener"
                data-event="cta_click"
                data-event-label={`route_${id}_outbound`}
                class="font-ui text-[0.98rem] underline underline-offset-4 decoration-line hover:decoration-graphite-3"
              >
                {r.outboundLabel || r.outboundHref}
              </a>
            </p>
          )}

          {contactHref && (
            <a
              href={r.ctaHref || contactHref}
              rel="noopener"
              data-event="cta_click"
              data-event-label={`route_${id}`}
              class="btn btn--primary mt-8"
            >
              {r.ctaLabel || 'Обсудить сценарий'}
            </a>
          )}

          <p class="mt-4 font-ui text-xs text-muted">
            Можно ничего не оставлять: маршрут уже перед вами.
          </p>
        </article>
      );
    })}
    </div>
  </div>
</section>

<script is:inline type="application/json" id="quiz-preset" set:html={JSON.stringify(preset)}></script>

<script>
  import { loadState, saveState, clearState, resolveRoute, answeredCount, type QuizState } from './engine';
  import { initAnalytics, track } from '@analytics/client';
  import type { QuizPreset } from './types';

  const root = document.getElementById('quiz-app');
  const presetEl = document.getElementById('quiz-preset');
  if (root && presetEl) {
    const preset: QuizPreset = JSON.parse(presetEl.textContent || '{}');
    const slug = root.dataset.slug!;
    const total = Number(root.dataset.total);

    initAnalytics(root.dataset.provider || 'none');

    const steps = [...root.querySelectorAll<HTMLElement>('[data-quiz-step]')];
    const bar = root.querySelector<HTMLElement>('[data-quiz-bar]')!;
    const current = root.querySelector<HTMLElement>('[data-quiz-current]')!;
    const backBtn = root.querySelector<HTMLButtonElement>('[data-quiz-back]')!;
    const restartBtn = root.querySelector<HTMLButtonElement>('[data-quiz-restart]')!;
    const routeSection = document.querySelector<HTMLElement>('[data-route-section]')!;

    let state: QuizState = loadState(slug);
    let started = answeredCount(preset, state.answers) > 0;

    // Шаг сменяется коротким проявлением: видно, что ответ принят и экран
    // переключился, а не что страница дёрнулась.
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const settle = (el: HTMLElement | null | undefined) => {
      if (!el || reduced || !el.animate) return;
      el.animate(
        [
          { opacity: 0, transform: 'translateY(6px)' },
          { opacity: 1, transform: 'none' },
        ],
        { duration: 260, easing: 'cubic-bezier(.2,.7,.2,1)' }
      );
    };

    function render(scroll = false, animate = false) {
      const idx = Math.min(state.step, total - 1);

      steps.forEach((el, i) => {
        const show = i === idx && !state.done;
        const changed = el.hidden === show;
        el.hidden = !show;
        if (show && animate && changed) settle(el);
      });

      // Восстанавливаем выбранные ответы — назад без потери.
      for (const [stepId, value] of Object.entries(state.answers)) {
        const input = root!.querySelector<HTMLInputElement>(
          `input[name="${stepId}"][value="${value}"]`
        );
        if (input) input.checked = true;
      }

      const answered = answeredCount(preset, state.answers);
      bar.style.width = `${Math.round((answered / total) * 100)}%`;
      current.textContent = String(state.done ? total : idx + 1);
      backBtn.hidden = state.done || idx === 0;
      restartBtn.hidden = !state.done;

      root!.querySelector<HTMLElement>('[data-quiz-progress]')!.hidden = state.done;

      if (state.done) {
        const routeId = resolveRoute(preset, state.answers);
        routeSection.hidden = false;
        routeSection
          .querySelectorAll<HTMLElement>('[data-route]')
          .forEach((el) => (el.hidden = el.dataset.route !== routeId));
        if (scroll) {
          routeSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
          settle(routeSection.querySelector<HTMLElement>(`[data-route="${routeId}"]`));
        }
      } else {
        routeSection.hidden = true;
      }
    }

    root.addEventListener('change', (e) => {
      const input = e.target as HTMLInputElement;
      if (!input.matches('[data-quiz-input]')) return;

      if (!started) {
        started = true;
        track('quiz_start', { slug });
      }

      state.answers[input.name] = input.value;
      track('quiz_step', { slug, step: input.name, answer: input.value });

      const next = state.step + 1;
      if (next >= total) {
        state.done = true;
        const routeId = resolveRoute(preset, state.answers);
        track('quiz_complete', { slug });
        track(`quiz_route_${routeId}`, { slug });
      } else {
        state.step = next;
      }

      saveState(slug, state);
      render(true, true);
    });

    backBtn.addEventListener('click', () => {
      state.step = Math.max(0, state.step - 1);
      saveState(slug, state);
      render(false, true);
    });

    restartBtn.addEventListener('click', () => {
      clearState(slug);
      state = { step: 0, answers: {}, done: false };
      started = false;
      root!
        .querySelectorAll<HTMLInputElement>('[data-quiz-input]')
        .forEach((i) => (i.checked = false));
      render();
      document.getElementById('quiz')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });

    render();
  }
</script>
