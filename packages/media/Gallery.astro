---
// Галерея рендеров и фотографий.
// На мобиле — лента со снапом внутри своего контейнера: страница по горизонтали
// не едет никогда. На десктопе — сетка. Клик открывает крупный кадр в <dialog>.
import { resolveAll } from './resolve.mjs';

interface Item { src: string; alt: string; caption?: string }
interface Props { slug: string; items: Item[]; title?: string; eyebrow?: string; note?: string }
const { slug, items = [], title, eyebrow, note } = Astro.props;

const images = resolveAll(items, slug).filter((i) => !i.missing);
---
{images.length > 0 && (
  <section id="gallery" class="band band--ruled">
    <div class="container-page">
      {eyebrow && (
        <p class="eyebrow mb-4">{eyebrow}</p>
      )}
      {title && (
        <h2 class="text-h2 max-w-[22ch] mb-5">{title}</h2>
      )}

      {/* Рендер, выданный за фотографию построенного дома, — обман.
          Оговорка стоит над кадрами, а не мелким шрифтом под ними. */}
      {note && <p class="text-small text-muted max-w-measure mb-12">{note}</p>}

      <div
        class="flex gap-4 overflow-x-auto snap-x snap-mandatory pb-4 -mx-6 px-6
               md:mx-0 md:px-0 md:grid md:grid-cols-2 lg:grid-cols-3 md:gap-5 md:overflow-visible"
        data-gallery
      >
        {images.map((img, i) => (
          <figure class="shrink-0 w-[85%] sm:w-[70%] md:w-auto snap-center m-0">
            <button
              type="button"
              class="block w-full p-0 border-0 bg-transparent cursor-zoom-in"
              data-gallery-open={String(i)}
              aria-label={`Открыть кадр: ${img.alt}`}
            >
              <img
                src={img.src}
                alt={img.alt}
                width={img.width}
                height={img.height}
                loading={i < 2 ? 'eager' : 'lazy'}
                decoding="async"
                class="w-full h-auto rounded bg-paper-dim object-cover aspect-[4/3]"
              />
            </button>
            {img.caption && (
              <figcaption class="mt-3 text-small text-muted">{img.caption}</figcaption>
            )}
          </figure>
        ))}
      </div>
    </div>

    <dialog
      data-gallery-dialog
      class="w-full max-w-5xl bg-ink text-paper p-0 border-0 rounded backdrop:bg-ink/80"
    >
      <button
        type="button"
        data-gallery-close
        class="absolute top-3 right-3 z-10 min-h-[44px] min-w-[44px] rounded bg-ink/70 text-paper font-ui text-sm"
        aria-label="Закрыть"
      >✕</button>
      <img data-gallery-image src="" alt="" class="w-full h-auto" />
      <p data-gallery-caption class="font-ui text-sm text-paper-dim p-5"></p>
    </dialog>
  </section>
)}

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-gallery-dialog]');
  const strip = document.querySelector<HTMLElement>('[data-gallery]');

  if (dialog && strip) {
    const big = dialog.querySelector<HTMLImageElement>('[data-gallery-image]')!;
    const cap = dialog.querySelector<HTMLElement>('[data-gallery-caption]')!;
    const figures = [...strip.querySelectorAll<HTMLElement>('figure')];

    strip.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-gallery-open]');
      if (!btn) return;
      const fig = figures[Number(btn.dataset.galleryOpen)];
      const img = fig?.querySelector('img');
      if (!img) return;
      big.src = img.src;
      big.alt = img.alt;
      const caption = fig.querySelector('figcaption')?.textContent ?? '';
      cap.textContent = caption;
      cap.hidden = !caption;
      dialog.showModal();
    });

    dialog.querySelector('[data-gallery-close]')?.addEventListener('click', () => dialog.close());
    // Клик по подложке закрывает: цель события — сам dialog, а не его содержимое.
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
    // Освобождаем память: без этого крупный кадр висит в документе до следующего открытия.
    dialog.addEventListener('close', () => {
      big.removeAttribute('src');
    });
  }
</script>
