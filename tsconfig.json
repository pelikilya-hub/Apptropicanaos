{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@ui/*": ["packages/ui/*"],
      "@fonar/*": ["packages/fonar/*"],
      "@insight/*": ["packages/insight/*"],
      "@quiz/*": ["packages/quiz/*"],
      "@explain/*": ["packages/explain/*"],
      "@seo/*": ["packages/seo/*"],
      "@analytics/*": ["packages/analytics/*"],
      "@legal/*": ["packages/legal/*"],
      "@config/*": ["packages/config/*"],
      "@templates/*": ["templates/*"]
    }
  },
  "include": ["src", "packages", "templates", "tooling", "*.mjs"],
  "exclude": ["dist", "node_modules"]
}
