{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://landing-factory.local/schemas/quiz.schema.json",
  "title": "Пресет квиза",
  "type": "object",
  "required": ["name", "steps", "routing", "fallbackRoute", "routes"],
  "properties": {
    "name": { "type": "string" },
    "steps": {
      "type": "array",
      "minItems": 4,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["id", "question", "options"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "question": { "type": "string", "minLength": 1 },
          "note": { "type": "string" },
          "options": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "required": ["id", "label"],
              "properties": {
                "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
                "label": { "type": "string", "minLength": 1 },
                "hint": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "routing": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["route", "when"],
        "properties": {
          "route": { "$ref": "#/definitions/routeId" },
          "when": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string" }
            }
          }
        }
      }
    },
    "fallbackRoute": { "$ref": "#/definitions/routeId" },
    "routes": {
      "type": "object",
      "required": ["fit", "neighbor", "budget", "learn", "remote"],
      "additionalProperties": {
        "type": "object",
        "required": ["title", "body"],
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "body": { "type": "string", "minLength": 1 },
          "ctaLabel": { "type": "string" },
          "ctaHref": { "type": "string" },
          "outboundLabel": { "type": "string" },
          "outboundHref": { "type": "string" }
        }
      }
    }
  },
  "definitions": {
    "routeId": { "type": "string", "enum": ["fit", "neighbor", "budget", "learn", "remote"] }
  }
}
